# Copy this file to `.env` and adjust the values.
# NEVER commit the real `.env` — it contains secrets.

# --- Required ----------------------------------------------------------------
# MongoDB connection string.
MONGO_URI=mongodb://127.0.0.1:27017
# Database name (the frontend does not depend on this value).
MONGO_DB=ticket_management_db

# Secret used to sign JWT access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The server refuses to start without it.
JWT_SECRET=change-me-to-a-long-random-string

# --- Optional ----------------------------------------------------------------
# Access-token lifetime (minutes). Default: 720 (12 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Best-effort in-memory rate limit for /auth/login and /auth/register,
# per client IP, requests per minute. 0 disables it. This protects a
# single uvicorn process only; deployments should also rate-limit at
# the reverse proxy. See README "Security notes".
AUTH_RATE_LIMIT_PER_MINUTE=10

# Invite code required to self-register an ADMIN account from the
# frontend register screen. Customers and agents never need it.
# Leave empty to disable admin self-registration entirely (admins are
# then only created with scripts/create_admin.py).
# ADMIN_INVITE_CODE=change-me-to-a-long-random-code
